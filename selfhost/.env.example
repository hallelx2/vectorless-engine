# Copy to .env and fill in. Only VECTORLESS_API_KEY and one answer-model key are required.

# The bearer token every API call carries. Generate one with: openssl rand -hex 32
VECTORLESS_API_KEY=

# The model that writes answers: anthropic | openai | gemini
VECTORLESS_LLM_PROVIDER=anthropic
VECTORLESS_ANTHROPIC_API_KEY=
# For an Anthropic-compatible gateway such as GLM on z.ai (base URL must end in /v1):
# VECTORLESS_ANTHROPIC_BASE_URL=https://api.z.ai/api/anthropic/v1
# VECTORLESS_ANTHROPIC_MODEL=glm-4.6
VECTORLESS_OPENAI_API_KEY=
VECTORLESS_GEMINI_API_KEY=
# Gemini on Vertex AI (VECTORLESS_LLM_PROVIDER=vertex): no key. On a GCP VM the
# attached service account authenticates; elsewhere mount a credentials file
# and set VECTORLESS_GOOGLE_CREDENTIALS_PATH to its path inside the container.
VECTORLESS_VERTEX_PROJECT=
VECTORLESS_VERTEX_LOCATION=global
VECTORLESS_VERTEX_MODEL=gemini-2.5-flash-lite
# Set a thinking budget (0 = off where the model allows) OR a level, not both.
VECTORLESS_VERTEX_THINKING_BUDGET=
VECTORLESS_VERTEX_THINKING_LEVEL=
# Off GCP: put a service-account key at ./gcp/key.json and uncomment.
# VECTORLESS_GOOGLE_CREDENTIALS_PATH=/etc/vectorless/gcp/key.json

# Jev (TypeSafe's System One model). Without it the engine still runs, but uses the
# slower generative walk and page-level citations instead of line-level pincites.
VECTORLESS_TYPESAFE_API_KEY=

# Optional
# VECTORLESS_POSTGRES_PASSWORD=vectorless
# VECTORLESS_VERSION=latest        # or a 12-character commit SHA tag
# VECTORLESS_PORT=8080
# VECTORLESS_BIND=127.0.0.1        # 0.0.0.0 to expose beyond this machine
